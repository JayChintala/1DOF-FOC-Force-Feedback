!STM32/MCWorkbench/STM32CubeIDE/.cproject
!STM32/MCWorkbench/STM32CubeIDE/.project
!STM32/MCWorkbench/STM32CubeIDE/*.launch
STM32/MCWorkbench/.mxproject

