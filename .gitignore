.log
.wbdef

# STM32CubeMX / ST Motor Control Workbench - Keep ONLY configs
# IGNORE generated files (can be regenerated)
STM32/MCWorkbench/Drivers/
STM32/MCWorkbench/MCSDK*/
STM32/MCWorkbench/EWARM/
